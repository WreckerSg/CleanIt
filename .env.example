# Copie este archivo como .env para usar Docker. No contiene secretos reales.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Bogota

DATABASE_NAME=cleanit
DATABASE_USER=cleanit
DATABASE_PASSWORD=replace-with-a-local-password
DATABASE_HOST=db
DATABASE_PORT=5432
